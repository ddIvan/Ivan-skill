            HandleAddClick() {
                var self = this;
                 top.OpenEditDialog({
                    title: "创建",
                    url: '@Url.RouteUrl("areas",new { action="Add",controller="{{TABLE_NAME}}"})',
                    width: "50%",
                    height: "700",
