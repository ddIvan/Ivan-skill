                        self.Query();
                    }
                });


            },
            HandleUpdateClick(row) {
                var self = this;
                 top.OpenEditDialog({
                    title: "编辑",
                    url: '@Url.RouteUrl("areas",new { action="Edit",controller="{{TABLE_NAME}}"})/'+row.ID,
                    width: "50%",
                    height: 700,
                    callback: function () {
                        self.Query();
                    }
                });


            },

            HandleDeleteClick(row) {
                this.HandleDelete('@Url.RouteUrl("areas",new { action="Delete",controller="{{TABLE_NAME}}"})/' + row.ID);
            },

