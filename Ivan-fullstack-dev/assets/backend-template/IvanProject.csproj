<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IvanProject</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ivan 内部框架包（从 IvanNuGet 私有源还原，见 nuget.config） -->
    <PackageReference Include="Ivan.Common" Version="1.0.8" />
    <PackageReference Include="Ivan.Data" Version="1.0.12" />
    <PackageReference Include="Ivan.Data.IOC" Version="1.0.9" />
    <!-- AddIvanIOC 扩展（Autofac 模式启动 + [InjectIOC] 接口扫描注册） -->
    <PackageReference Include="Ivan.IOC" Version="1.0.5" />
    <!-- MSSQL 数据库驱动；MySQL/SQLite 项目替换为对应 Provider 包 -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.33" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!--
      其他 Ivan 系列内部库（按需启用），还原时自动走 nuget.config 中的 IvanNuGet 源：
      <PackageReference Include="Ivan.Log" Version="1.0.7" />
      <PackageReference Include="Ivan.Security" Version="1.0.0" />
    -->
    <!-- Redis 缓存支持：RedisCacheService（ICacheService 生产实现）依赖 Ivan.Redis。
         MenuCacheService 基于 IMemoryCache，无需此包。 -->
    <PackageReference Include="Ivan.Redis" Version="1.0.0" />
  </ItemGroup>

</Project>
