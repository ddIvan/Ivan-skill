<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 托管 ASP.NET Core (.NET 6.0) 后端所需的 web.config
  使用注意：
  1. 编译后（如 dotnet publish -c Release -o ./publish）将本文件一并放置到发布目录根目录；
     或将本文件放在项目根目录并把 build 输出复制到 IIS 站点物理路径。
  2. arguments 中的 IvanProject.dll 必须替换为实际发布的程序集名，=
     名称即为 .csproj 文件名（如项目重命名为 MyApp 则改为 .\MyApp.dll）。
  3. IIS 站点应用池 .NET CLR 版本选"无托管代码 (No Managed Code)"；
     ASP.NET Core Module (ANCM) 与 .NET 6 Runtime 需已安装。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\IvanProject.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <rewrite>
        <rules>
          <!-- 可选：如需反向代理 / URL 重写（如前端 History 路由回退）在此添加规则 -->
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>