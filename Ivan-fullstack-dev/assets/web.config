<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 托管 ASP.NET Core (.NET 6.0) 后端所需的 web.config 模板
  使用方法：
  1. 将本文件复制到后端发布目录（publish/）根目录
  2. 将 arguments 中的 IvanProject.dll 替换为实际发布的程序集名
  3. 在 IIS 中创建站点指向该物理路径，应用池 .NET CLR 版本选"无托管代码"
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\IvanProject.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <rewrite>
        <rules>
          <!-- 可选：如需反向代理到其他服务可在此添加规则 -->
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>
